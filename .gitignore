# Harness configuration — local to each machine, not part of the product.
# Anchored with a leading slash so it matches only the repo-root .claude,
# never a nested one under src/.
/.claude/

# Docs are local-only by user decision — includes docs/ddr/ (design records)
# and docs/claude-md/ (the files CLAUDE.md links to). Anchored so a future
# src/**/docs/ is unaffected.
/docs/

# The memory system IS tracked — CLAUDE.md treats it as mandatory and every
# sub-agent is told to read it. Only the noisy machine-generated trace is
# excluded.
/memory/event-trace/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Environment / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Reports generated INTO a target repo are that repo's concern, not ours —
# but ignore any that land here during local testing against ourselves.
/reports/
